<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_online-purchase-order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="online-purchase-order" name="Online Purchase Order Processing" isExecutable="true">
    <bpmn:documentation>Processes an online order from placement to shipping confirmation. Stock is verified before payment is taken, so the business never has to refund an order it cannot fulfil. Two failure branches exit the process early.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Customer places order">
      <bpmn:documentation>Triggered when a customer submits an order through the online store.</bpmn:documentation>
      <bpmn:outgoing>Flow_OrderPlaced</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckAvailability" name="Check product availability">
      <bpmn:documentation>Queries the inventory system for stock. Deliberately performed before payment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-product-availability" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Flow_StockChecked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ProductAvailable" name="Product available?" default="Flow_OutOfStock">
      <bpmn:documentation>Exclusive decision on stock availability.</bpmn:documentation>
      <bpmn:incoming>Flow_StockChecked</bpmn:incoming>
      <bpmn:outgoing>Flow_InStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_OutOfStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ProcessPayment" name="Process payment">
      <bpmn:documentation>Charges the customer through the payment provider.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InStock</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentAttempted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccessful" name="Payment successful?" default="Flow_PaymentFailed">
      <bpmn:documentation>Exclusive decision on the payment result.</bpmn:documentation>
      <bpmn:incoming>Flow_PaymentAttempted</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ConfirmOrder" name="Confirm order">
      <bpmn:documentation>Marks the order as confirmed in order management.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="confirm-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentOk</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderConfirmed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareShipment" name="Prepare shipment">
      <bpmn:documentation>Warehouse picks and packs the product.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare-shipment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderConfirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_ShipmentPrepared</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShipOrder" name="Ship order">
      <bpmn:documentation>Handover of the packed order to the carrier.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ship-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ShipmentPrepared</bpmn:incoming>
      <bpmn:outgoing>Flow_Shipped</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShippingConfirmation" name="Send shipping confirmation">
      <bpmn:documentation>Sends tracking details so the customer can follow the delivery.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-shipping-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Shipped</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerInformed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order completed">
      <bpmn:documentation>Terminal state: paid, shipped and confirmed.</bpmn:documentation>
      <bpmn:incoming>Flow_CustomerInformed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyPaymentFailed" name="Notify payment failure">
      <bpmn:documentation>Tells the customer the payment did not go through.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-payment-failure" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_FailureNotified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PaymentFailed" name="Order not completed">
      <bpmn:documentation>Terminal state: stock was available but payment failed.</bpmn:documentation>
      <bpmn:incoming>Flow_FailureNotified</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyOutOfStock" name="Notify out of stock">
      <bpmn:documentation>Tells the customer the product is unavailable. No payment is attempted.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-out-of-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OutOfStock</bpmn:incoming>
      <bpmn:outgoing>Flow_StockNotified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_OutOfStock" name="Order cancelled">
      <bpmn:documentation>Terminal state: rejected at the availability check.</bpmn:documentation>
      <bpmn:incoming>Flow_StockNotified</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OrderPlaced" sourceRef="StartEvent_OrderPlaced" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_StockChecked" sourceRef="Task_CheckAvailability" targetRef="Gateway_ProductAvailable" />
    <bpmn:sequenceFlow id="Flow_InStock" name="Available" sourceRef="Gateway_ProductAvailable" targetRef="Task_ProcessPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=productAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OutOfStock" name="Unavailable" sourceRef="Gateway_ProductAvailable" targetRef="Task_NotifyOutOfStock">
      <bpmn:documentation>Default flow.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentAttempted" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentSuccessful" />
    <bpmn:sequenceFlow id="Flow_PaymentOk" name="Successful" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_ConfirmOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentFailed" name="Failed" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_NotifyPaymentFailed">
      <bpmn:documentation>Default flow.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OrderConfirmed" sourceRef="Task_ConfirmOrder" targetRef="Task_PrepareShipment" />
    <bpmn:sequenceFlow id="Flow_ShipmentPrepared" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_Shipped" sourceRef="Task_ShipOrder" targetRef="Task_ShippingConfirmation" />
    <bpmn:sequenceFlow id="Flow_CustomerInformed" sourceRef="Task_ShippingConfirmation" targetRef="EndEvent_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_FailureNotified" sourceRef="Task_NotifyPaymentFailed" targetRef="EndEvent_PaymentFailed" />
    <bpmn:sequenceFlow id="Flow_StockNotified" sourceRef="Task_NotifyOutOfStock" targetRef="EndEvent_OutOfStock" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="online-purchase-order">
      <bpmndi:BPMNShape id="StartEvent_OrderPlaced_di" bpmnElement="StartEvent_OrderPlaced">
        <dc:Bounds x="132" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="95" y="176" width="109" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckAvailability_di" bpmnElement="Task_CheckAvailability">
        <dc:Bounds x="280" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ProductAvailable_di" bpmnElement="Gateway_ProductAvailable" isMarkerVisible="true">
        <dc:Bounds x="525" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="183" width="76" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="680" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentSuccessful_di" bpmnElement="Gateway_PaymentSuccessful" isMarkerVisible="true">
        <dc:Bounds x="925" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="909" y="183" width="82" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmOrder_di" bpmnElement="Task_ConfirmOrder">
        <dc:Bounds x="1080" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareShipment_di" bpmnElement="Task_PrepareShipment">
        <dc:Bounds x="1280" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="1480" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShippingConfirmation_di" bpmnElement="Task_ShippingConfirmation">
        <dc:Bounds x="1680" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OrderCompleted_di" bpmnElement="EndEvent_OrderCompleted">
        <dc:Bounds x="1932" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1895" y="176" width="109" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyPaymentFailed_di" bpmnElement="Task_NotifyPaymentFailed">
        <dc:Bounds x="1080" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PaymentFailed_di" bpmnElement="EndEvent_PaymentFailed">
        <dc:Bounds x="1332" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1315" y="346" width="70" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyOutOfStock_di" bpmnElement="Task_NotifyOutOfStock">
        <dc:Bounds x="680" y="450" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OutOfStock_di" bpmnElement="EndEvent_OutOfStock">
        <dc:Bounds x="932" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="895" y="516" width="109" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_OrderPlaced_di" bpmnElement="Flow_OrderPlaced">
        <di:waypoint x="168" y="150" />
        <di:waypoint x="280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_StockChecked_di" bpmnElement="Flow_StockChecked">
        <di:waypoint x="420" y="150" />
        <di:waypoint x="525" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InStock_di" bpmnElement="Flow_InStock">
        <di:waypoint x="575" y="150" />
        <di:waypoint x="680" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="594" y="86" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OutOfStock_di" bpmnElement="Flow_OutOfStock">
        <di:waypoint x="550" y="175" />
        <di:waypoint x="550" y="490" />
        <di:waypoint x="680" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="466" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentAttempted_di" bpmnElement="Flow_PaymentAttempted">
        <di:waypoint x="820" y="150" />
        <di:waypoint x="925" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentOk_di" bpmnElement="Flow_PaymentOk">
        <di:waypoint x="975" y="150" />
        <di:waypoint x="1080" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="990" y="86" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentFailed_di" bpmnElement="Flow_PaymentFailed">
        <di:waypoint x="950" y="175" />
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1080" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="991" y="296" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OrderConfirmed_di" bpmnElement="Flow_OrderConfirmed">
        <di:waypoint x="1220" y="150" />
        <di:waypoint x="1280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShipmentPrepared_di" bpmnElement="Flow_ShipmentPrepared">
        <di:waypoint x="1420" y="150" />
        <di:waypoint x="1480" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Shipped_di" bpmnElement="Flow_Shipped">
        <di:waypoint x="1620" y="150" />
        <di:waypoint x="1680" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CustomerInformed_di" bpmnElement="Flow_CustomerInformed">
        <di:waypoint x="1820" y="150" />
        <di:waypoint x="1932" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FailureNotified_di" bpmnElement="Flow_FailureNotified">
        <di:waypoint x="1220" y="320" />
        <di:waypoint x="1332" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_StockNotified_di" bpmnElement="Flow_StockNotified">
        <di:waypoint x="820" y="490" />
        <di:waypoint x="932" y="490" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
