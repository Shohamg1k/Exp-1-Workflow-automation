<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_employee-leave-approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="employee-leave-approval" name="Employee Leave Approval" isExecutable="true">
    <bpmn:documentation>Handles an employee leave request from submission to notification. The leave balance is validated before any manager time is consumed, and each of the three business outcomes terminates in its own end event.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_LeaveRequested" name="Leave request submitted">
      <bpmn:documentation>Triggered when an employee submits a leave request through the HR system.</bpmn:documentation>
      <bpmn:outgoing>Flow_Submitted</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckBalance" name="Check leave balance">
      <bpmn:documentation>Retrieves the employee's remaining leave entitlement from HR records.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-leave-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submitted</bpmn:incoming>
      <bpmn:outgoing>Flow_BalanceChecked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_BalanceSufficient" name="Sufficient balance?" default="Flow_BalanceShort">
      <bpmn:documentation>Exclusive decision: the balance either covers the request or it does not.</bpmn:documentation>
      <bpmn:incoming>Flow_BalanceChecked</bpmn:incoming>
      <bpmn:outgoing>Flow_BalanceOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_BalanceShort</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManagerReview" name="Review leave request">
      <bpmn:documentation>Human decision by the line manager. The process waits here until the manager acts.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BalanceOk</bpmn:incoming>
      <bpmn:outgoing>Flow_Reviewed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager approved?" default="Flow_Rejected">
      <bpmn:documentation>Exclusive decision based on the manager's verdict.</bpmn:documentation>
      <bpmn:incoming>Flow_Reviewed</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateBalance" name="Update leave balance">
      <bpmn:documentation>Deducts the approved days. Performed before notifying, so the employee is never told about a change that failed to persist.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-leave-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_BalanceUpdated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyApproved" name="Send approval notice">
      <bpmn:documentation>Informs the employee that the request was approved.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-approval-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BalanceUpdated</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Approved" name="Leave approved">
      <bpmn:documentation>Terminal state: leave granted and balance updated.</bpmn:documentation>
      <bpmn:incoming>Flow_ApprovalSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyRejected" name="Send rejection notice">
      <bpmn:documentation>Informs the employee that the manager declined the request.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectionSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Leave rejected">
      <bpmn:documentation>Terminal state: manager declined. Balance is unchanged.</bpmn:documentation>
      <bpmn:incoming>Flow_RejectionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyInsufficient" name="Notify insufficient balance">
      <bpmn:documentation>Informs the employee the request cannot proceed. No manager time is consumed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-insufficient-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BalanceShort</bpmn:incoming>
      <bpmn:outgoing>Flow_ShortageSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Insufficient" name="Request declined">
      <bpmn:documentation>Terminal state: rejected automatically before reaching a human.</bpmn:documentation>
      <bpmn:incoming>Flow_ShortageSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Submitted" sourceRef="StartEvent_LeaveRequested" targetRef="Task_CheckBalance" />
    <bpmn:sequenceFlow id="Flow_BalanceChecked" sourceRef="Task_CheckBalance" targetRef="Gateway_BalanceSufficient" />
    <bpmn:sequenceFlow id="Flow_BalanceOk" name="Sufficient" sourceRef="Gateway_BalanceSufficient" targetRef="Task_ManagerReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=leaveBalance &gt;= requestedDays</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BalanceShort" name="Insufficient" sourceRef="Gateway_BalanceSufficient" targetRef="Task_NotifyInsufficient">
      <bpmn:documentation>Default flow: guarantees a valid path when the condition evaluates false.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reviewed" sourceRef="Task_ManagerReview" targetRef="Gateway_ManagerDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_UpdateBalance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_NotifyRejected">
      <bpmn:documentation>Default flow.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BalanceUpdated" sourceRef="Task_UpdateBalance" targetRef="Task_NotifyApproved" />
    <bpmn:sequenceFlow id="Flow_ApprovalSent" sourceRef="Task_NotifyApproved" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_RejectionSent" sourceRef="Task_NotifyRejected" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_ShortageSent" sourceRef="Task_NotifyInsufficient" targetRef="EndEvent_Insufficient" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="employee-leave-approval">
      <bpmndi:BPMNShape id="StartEvent_LeaveRequested_di" bpmnElement="StartEvent_LeaveRequested">
        <dc:Bounds x="132" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="102" y="176" width="95" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckBalance_di" bpmnElement="Task_CheckBalance">
        <dc:Bounds x="280" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_BalanceSufficient_di" bpmnElement="Gateway_BalanceSufficient" isMarkerVisible="true">
        <dc:Bounds x="525" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="183" width="76" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerReview_di" bpmnElement="Task_ManagerReview">
        <dc:Bounds x="680" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision" isMarkerVisible="true">
        <dc:Bounds x="925" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="889" y="183" width="122" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_di" bpmnElement="Task_UpdateBalance">
        <dc:Bounds x="1080" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyApproved_di" bpmnElement="Task_NotifyApproved">
        <dc:Bounds x="1280" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1532" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1499" y="176" width="102" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRejected_di" bpmnElement="Task_NotifyRejected">
        <dc:Bounds x="1080" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1332" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1299" y="346" width="102" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyInsufficient_di" bpmnElement="Task_NotifyInsufficient">
        <dc:Bounds x="680" y="450" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Insufficient_di" bpmnElement="EndEvent_Insufficient">
        <dc:Bounds x="932" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="892" y="516" width="115" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Submitted_di" bpmnElement="Flow_Submitted">
        <di:waypoint x="168" y="150" />
        <di:waypoint x="280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BalanceChecked_di" bpmnElement="Flow_BalanceChecked">
        <di:waypoint x="420" y="150" />
        <di:waypoint x="525" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BalanceOk_di" bpmnElement="Flow_BalanceOk">
        <di:waypoint x="575" y="150" />
        <di:waypoint x="680" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="590" y="86" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BalanceShort_di" bpmnElement="Flow_BalanceShort">
        <di:waypoint x="550" y="175" />
        <di:waypoint x="550" y="490" />
        <di:waypoint x="680" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="571" y="466" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reviewed_di" bpmnElement="Flow_Reviewed">
        <di:waypoint x="820" y="150" />
