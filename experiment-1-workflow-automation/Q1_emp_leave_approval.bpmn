      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectionSent_di" bpmnElement="Flow_RejectionSent">
        <di:waypoint x="1220" y="320" />
        <di:waypoint x="1332" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShortageSent_di" bpmnElement="Flow_ShortageSent">
        <di:waypoint x="820" y="490" />
        <di:waypoint x="932" y="490" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
