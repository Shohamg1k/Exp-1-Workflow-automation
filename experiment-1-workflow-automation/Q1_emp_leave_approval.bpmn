      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="975" y="150" />
        <di:waypoint x="1080" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="997" y="86" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="950" y="175" />
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1080" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="985" y="296" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BalanceUpdated_di" bpmnElement="Flow_BalanceUpdated">
        <di:waypoint x="1220" y="150" />
        <di:waypoint x="1280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalSent_di" bpmnElement="Flow_ApprovalSent">
        <di:waypoint x="1420" y="150" />
