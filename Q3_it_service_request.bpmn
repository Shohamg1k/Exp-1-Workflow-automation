<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_it-service-request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="it-service-request" name="IT Service Request Handling" isExecutable="true">
    <bpmn:documentation>Handles an employee IT support request from submission to closure. Two exclusive splits (severity triage and internal resolvability) are each paired with an exclusive merge, so the closing steps are modelled once rather than duplicated across four branches.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_RequestSubmitted" name="IT support request submitted">
      <bpmn:documentation>Triggered when an employee reports an IT problem.</bpmn:documentation>
      <bpmn:outgoing>Flow_Submitted</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RegisterRequest" name="Register the request">
      <bpmn:documentation>Help desk creates the ticket record.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submitted</bpmn:incoming>
      <bpmn:outgoing>Flow_Registered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CheckSeverity" name="Check problem severity">
      <bpmn:documentation>A help desk agent assesses business impact and assigns a severity level.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Registered</bpmn:incoming>
      <bpmn:outgoing>Flow_Triaged</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SeverityLevel" name="Severity level?" default="Flow_HighSeverity">
      <bpmn:documentation>Triage split routing the ticket to the appropriate skill level.</bpmn:documentation>
      <bpmn:incoming>Flow_Triaged</bpmn:incoming>
      <bpmn:outgoing>Flow_LowSeverity</bpmn:outgoing>
      <bpmn:outgoing>Flow_HighSeverity</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AssignSupport" name="Assign to support technician">
      <bpmn:documentation>Low severity is handled by first-line support.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assign-support-technician" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LowSeverity</bpmn:incoming>
      <bpmn:outgoing>Flow_SupportAssigned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AssignSenior" name="Assign to senior technician">
      <bpmn:documentation>High severity goes straight to a senior technician.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assign-senior-technician" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighSeverity</bpmn:incoming>
      <bpmn:outgoing>Flow_SeniorAssigned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Assigned" name="">
      <bpmn:documentation>Exclusive merge. Only one assignment branch was taken, so an exclusive rather than parallel merge is required.</bpmn:documentation>
      <bpmn:incoming>Flow_SupportAssigned</bpmn:incoming>
      <bpmn:incoming>Flow_SeniorAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadyToInvestigate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Investigate" name="Investigate the problem">
      <bpmn:documentation>The assigned technician diagnoses the issue.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReadyToInvestigate</bpmn:incoming>
      <bpmn:outgoing>Flow_Investigated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Resolvable" name="Resolvable internally?" default="Flow_CannotFix">
      <bpmn:documentation>Exclusive decision on whether internal capability is sufficient.</bpmn:documentation>
      <bpmn:incoming>Flow_Investigated</bpmn:incoming>
      <bpmn:outgoing>Flow_CanFix</bpmn:outgoing>
      <bpmn:outgoing>Flow_CannotFix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixProblem" name="Fix the problem">
      <bpmn:documentation>Technician resolves the issue in-house.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CanFix</bpmn:incoming>
      <bpmn:outgoing>Flow_Fixed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Escalate" name="Escalate to external provider">
      <bpmn:documentation>Hands the issue to the external service provider under the support contract.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate-to-provider" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CannotFix</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Resolved" name="">
      <bpmn:documentation>Exclusive merge. Closure is identical regardless of who resolved the issue.</bpmn:documentation>
      <bpmn:incoming>Flow_Fixed</bpmn:incoming>
      <bpmn:incoming>Flow_Escalated</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolutionReached</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateStatus" name="Update request status">
      <bpmn:documentation>Records the resolution against the ticket.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-request-status" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ResolutionReached</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusUpdated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyResolution" name="Send resolution notice">
      <bpmn:documentation>Closes the loop with the employee.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-resolution-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StatusUpdated</bpmn:incoming>
      <bpmn:outgoing>Flow_EmployeeNotified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RequestClosed" name="Request closed">
      <bpmn:documentation>Terminal state: every path converges here. How it was resolved is held in ticket data, not process topology.</bpmn:documentation>
      <bpmn:incoming>Flow_EmployeeNotified</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Submitted" sourceRef="StartEvent_RequestSubmitted" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_Registered" sourceRef="Task_RegisterRequest" targetRef="Task_CheckSeverity" />
    <bpmn:sequenceFlow id="Flow_Triaged" sourceRef="Task_CheckSeverity" targetRef="Gateway_SeverityLevel" />
    <bpmn:sequenceFlow id="Flow_LowSeverity" name="Low" sourceRef="Gateway_SeverityLevel" targetRef="Task_AssignSupport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=severity = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HighSeverity" name="High" sourceRef="Gateway_SeverityLevel" targetRef="Task_AssignSenior">
      <bpmn:documentation>Default flow.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupportAssigned" sourceRef="Task_AssignSupport" targetRef="Gateway_Assigned" />
    <bpmn:sequenceFlow id="Flow_SeniorAssigned" sourceRef="Task_AssignSenior" targetRef="Gateway_Assigned" />
    <bpmn:sequenceFlow id="Flow_ReadyToInvestigate" sourceRef="Gateway_Assigned" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_Investigated" sourceRef="Task_Investigate" targetRef="Gateway_Resolvable" />
    <bpmn:sequenceFlow id="Flow_CanFix" name="Yes" sourceRef="Gateway_Resolvable" targetRef="Task_FixProblem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resolvableInternally = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CannotFix" name="No" sourceRef="Gateway_Resolvable" targetRef="Task_Escalate">
      <bpmn:documentation>Default flow.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fixed" sourceRef="Task_FixProblem" targetRef="Gateway_Resolved" />
    <bpmn:sequenceFlow id="Flow_Escalated" sourceRef="Task_Escalate" targetRef="Gateway_Resolved" />
    <bpmn:sequenceFlow id="Flow_ResolutionReached" sourceRef="Gateway_Resolved" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_StatusUpdated" sourceRef="Task_UpdateStatus" targetRef="Task_NotifyResolution" />
    <bpmn:sequenceFlow id="Flow_EmployeeNotified" sourceRef="Task_NotifyResolution" targetRef="EndEvent_RequestClosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="it-service-request">
      <bpmndi:BPMNShape id="StartEvent_RequestSubmitted_di" bpmnElement="StartEvent_RequestSubmitted">
        <dc:Bounds x="132" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="89" y="346" width="122" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterRequest_di" bpmnElement="Task_RegisterRequest">
        <dc:Bounds x="280" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSeverity_di" bpmnElement="Task_CheckSeverity">
        <dc:Bounds x="480" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SeverityLevel_di" bpmnElement="Gateway_SeverityLevel" isMarkerVisible="true">
        <dc:Bounds x="725" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="695" y="353" width="109" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignSupport_di" bpmnElement="Task_AssignSupport">
        <dc:Bounds x="880" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignSenior_di" bpmnElement="Task_AssignSenior">
        <dc:Bounds x="880" y="450" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Assigned_di" bpmnElement="Gateway_Assigned" isMarkerVisible="true">
        <dc:Bounds x="1125" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Investigate_di" bpmnElement="Task_Investigate">
        <dc:Bounds x="1280" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Resolvable_di" bpmnElement="Gateway_Resolvable" isMarkerVisible="true">
        <dc:Bounds x="1525" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1509" y="353" width="82" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixProblem_di" bpmnElement="Task_FixProblem">
        <dc:Bounds x="1680" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="1680" y="450" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Resolved_di" bpmnElement="Gateway_Resolved" isMarkerVisible="true">
        <dc:Bounds x="1925" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateStatus_di" bpmnElement="Task_UpdateStatus">
        <dc:Bounds x="2080" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyResolution_di" bpmnElement="Task_NotifyResolution">
        <dc:Bounds x="2280" y="280" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RequestClosed_di" bpmnElement="EndEvent_RequestClosed">
        <dc:Bounds x="2532" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2499" y="346" width="102" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Submitted_di" bpmnElement="Flow_Submitted">
        <di:waypoint x="168" y="320" />
        <di:waypoint x="280" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Registered_di" bpmnElement="Flow_Registered">
        <di:waypoint x="420" y="320" />
        <di:waypoint x="480" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Triaged_di" bpmnElement="Flow_Triaged">
        <di:waypoint x="620" y="320" />
        <di:waypoint x="725" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LowSeverity_di" bpmnElement="Flow_LowSeverity">
        <di:waypoint x="750" y="295" />
        <di:waypoint x="750" y="150" />
        <di:waypoint x="880" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="126" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HighSeverity_di" bpmnElement="Flow_HighSeverity">
        <di:waypoint x="750" y="345" />
        <di:waypoint x="750" y="490" />
        <di:waypoint x="880" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="466" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SupportAssigned_di" bpmnElement="Flow_SupportAssigned">
        <di:waypoint x="1020" y="150" />
        <di:waypoint x="1150" y="150" />
        <di:waypoint x="1150" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SeniorAssigned_di" bpmnElement="Flow_SeniorAssigned">
        <di:waypoint x="1020" y="490" />
        <di:waypoint x="1150" y="490" />
        <di:waypoint x="1150" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReadyToInvestigate_di" bpmnElement="Flow_ReadyToInvestigate">
        <di:waypoint x="1175" y="320" />
        <di:waypoint x="1280" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Investigated_di" bpmnElement="Flow_Investigated">
        <di:waypoint x="1420" y="320" />
        <di:waypoint x="1525" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CanFix_di" bpmnElement="Flow_CanFix">
        <di:waypoint x="1550" y="295" />
        <di:waypoint x="1550" y="150" />
        <di:waypoint x="1680" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1595" y="126" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CannotFix_di" bpmnElement="Flow_CannotFix">
        <di:waypoint x="1550" y="345" />
        <di:waypoint x="1550" y="490" />
        <di:waypoint x="1680" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1595" y="466" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fixed_di" bpmnElement="Flow_Fixed">
        <di:waypoint x="1820" y="150" />
        <di:waypoint x="1950" y="150" />
        <di:waypoint x="1950" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalated_di" bpmnElement="Flow_Escalated">
        <di:waypoint x="1820" y="490" />
        <di:waypoint x="1950" y="490" />
        <di:waypoint x="1950" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ResolutionReached_di" bpmnElement="Flow_ResolutionReached">
        <di:waypoint x="1975" y="320" />
        <di:waypoint x="2080" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_StatusUpdated_di" bpmnElement="Flow_StatusUpdated">
        <di:waypoint x="2220" y="320" />
        <di:waypoint x="2280" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EmployeeNotified_di" bpmnElement="Flow_EmployeeNotified">
        <di:waypoint x="2420" y="320" />
        <di:waypoint x="2532" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
